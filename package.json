{
  "name": "afrimart",
  "private": true,
  "packageManager": "npm@11.6.2",
  "workspaces": [
    "apps/*",
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "db:generate": "npm run generate --workspace=@afrimart/backend",
    "test": "turbo run test",
    "check:setup": "node tools/check-setup.mjs",
    "e2e:ops": "tsx tools/browser/ops-console.e2e.ts",
    "eval:shelves": "node --import tsx tools/evaluation/shelves.mts",
    "eval:deliveries": "node --import tsx tools/evaluation/deliveries.mts",
    "e2e:website-import": "node --env-file=services/backend/.env --import tsx tools/browser/website-import.e2e.mts",
    "verify:shelf-retention": "node --env-file=services/backend/.env --import tsx tools/evaluation/retention.mts",
    "test:shelf-evaluation": "node --import tsx --test tools/evaluation/shelves.test.mts",
    "e2e:catalogue": "node --env-file=services/backend/.env --import tsx tools/browser/catalogue-review.e2e.ts",
    "e2e:shelves": "node --env-file=services/backend/.env --import tsx tools/browser/shelf-capture.e2e.ts",
    "e2e:onboarding": "node --env-file=services/backend/.env --import tsx tools/browser/onboarding.e2e.ts"
  },
  "devDependencies": {
    "turbo": "latest",
    "typescript": "^5.6.0"
  },
  "engines": {
    "node": ">=20.12"
  }
}
