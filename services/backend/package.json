{
  "name": "@afrimart/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "generate": "prisma generate",
    "migrate:dev": "prisma migrate dev",
    "seed": "tsx prisma/seed.ts",
    "test": "tsx --test \"src/**/*.test.ts\"",
    "verify:economics": "tsx src/scripts/verify-economics.ts",
    "verify:loop": "tsx src/scripts/verify-order-loop.ts",
    "seed:staff": "tsx src/scripts/seed-staff.ts",
    "verify:auth": "tsx src/scripts/verify-ops-auth.ts",
    "verify:lockout": "tsx src/scripts/verify-lockout.ts",
    "build:emails": "tsx src/scripts/build-email-templates.ts",
    "verify:notifications": "tsx src/scripts/verify-notifications.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@afrimart/shared": "*",
    "@fastify/cors": "^10.0.0",
    "@prisma/client": "^5.20.0",
    "@trpc/server": "^11.0.0",
    "fastify": "^5.0.0",
    "otplib": "^13.5.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
