DATABASE_URL="postgresql://postgres:postgres@localhost:5432/afrimart?connect_timeout=30&pool_timeout=30"
PORT=4000

STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

EASYPOST_API_KEY=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MESSAGING_SERVICE_SID=

ANTHROPIC_API_KEY=
VOYAGE_API_KEY=

# Photo storage. Leave all S3_* unset in development (photos go to .uploads/).
# Anywhere else the server will not start without them. A private bucket with
# public access blocked: AWS S3, Cloudflare R2, or MinIO.
# R2:    S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com  (region is "auto")
# MinIO: S3_ENDPOINT=http://localhost:9100
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT=
S3_REGION=
S3_KEY_PREFIX=
S3_SERVER_SIDE_ENCRYPTION=

# Signed photo links. 32 or more random characters; required outside development.
PHOTO_URL_SECRET=
PHOTO_URL_TTL_SECONDS=300

# Browser origins allowed to call the API, comma-separated (localhost is always allowed).
CORS_ORIGINS=

# Sign-in codes by text (store owners). Off until the A2P 10DLC campaign clears.
SMS_ENABLED=
TWILIO_FROM_NUMBER=
