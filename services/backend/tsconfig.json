{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"]
  },
  "include": ["src"],
  "//": "Tests run through tsx and must not be emitted into dist; tsconfig.typecheck.json still type-checks them.",
  "exclude": ["src/**/*.test.ts"]
}
