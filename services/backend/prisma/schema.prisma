// First-pass schema mirroring packages/shared's types and PRD section 9's
// data model. Field-level detail will grow as Prompt 8 (catalogue, orders,
// routing, payments) is built out — this is the scaffold, not the final shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TemperatureClass {
  ambient
  refrigerated
  frozen
}

enum SellerType {
  store
  home_seller
  aspiring_entrepreneur
}

enum OnboardingStatus {
  pending
  filming
  reviewing
  kit_issued
  live
  suspended
  delisted
}

enum StockStatus {
  in_stock
  made_to_order
  out_of_stock
}

enum OrderStatus {
  placed
  accepted
  packed
  shipped
  delivered
  cancelled
}

enum ShipmentStatus {
  pending
  declined
  label_created
  picked_up
  in_transit
  delivered
  exception
}

model HubMetro {
  id        String   @id @default(cuid())
  name      String
  state     String
  active    Boolean  @default(true)
  stores    Store[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id                    String            @id @default(cuid())
  name                  String
  ownerName             String
  /// The owner's mobile number in E.164, which is how the owner signs in to the
  /// merchant app (a code is texted to it). Set at onboarding. Null until then,
  /// and a store with none cannot sign in.
  ownerPhone            String?           @unique
  ownerPhoneVerifiedAt  DateTime?
  ownerPhoneVersion     Int               @default(0)
  onboardingStartedAt   DateTime?
  onboardingProfileAt   DateTime?
  /// How the seller sources catalogue drafts: shelf capture (film) or website import (web).
  onboardingRail        String?
  onboardingWebsite     String?
  filmSession           FilmSession?
  onboardingInvites     OnboardingInvite[]
  onboardingKits        OnboardingKit[]
  userSessions          UserSession[]
  messages              SellerMessage[]
  sellerType            SellerType
  hubMetro              HubMetro          @relation(fields: [hubMetroId], references: [id])
  hubMetroId            String
  onboardingStatus      OnboardingStatus  @default(pending)
  verificationStatus    String            @default("unverified")
  foodSafetyAttestedAt  DateTime?
  verifiedAt            DateTime?
  qualityScore          Float?
  payoutAccountId       String?
  listings              Listing[]
  deliveryReceipts      DeliveryReceipt[]
  shipments             Shipment[]
  payouts               Payout[]
  carrierAdjustments    CarrierAdjustment[]
  catalogueDrafts       CatalogueDraft[]
  badges                SellerBadge[]
  enforcements          SellerEnforcement[]
  kitchenLicence        KitchenLicence?
  categoryControls      SellerCategoryControl[]
  permitConfirmations   PermitConfirmation[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model CanonicalProduct {
  id                String            @id @default(cuid())
  canonicalName     String
  /// Short plain-English gloss, e.g. "melon seeds" -- composed with canonicalName/packSize for card subtitles.
  shortDescription  String
  /// AGT-6 grounding text and the product page's "How it's used" copy.
  usedDescription   String
  category          String
  cuisine           String
  packSize          String
  images            String[]
  temperatureClass  TemperatureClass
  /// QC-1 — set when the product is meat, poultry, fish or dairy, shelf-stable
  /// or not (dried fish, crayfish, stockfish and kilishi are all controlled).
  /// Classified here rather than inferred from `category` text, because a
  /// control that depends on a free-text label misses whatever is filed
  /// under a different one. Null means none of the four.
  controlledCategory ControlledCategory?
  shippingWeightOz  Float
  /// CAT-5 — carriers bill the greater of actual and dimensional weight.
  lengthIn          Float            @default(8)
  widthIn           Float            @default(6)
  heightIn          Float            @default(4)
  aliases           NameAlias[]
  listings          Listing[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model NameAlias {
  id                 String           @id @default(cuid())
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  canonicalProductId String
  alias              String
  language           String
  confidence         Float

  @@index([alias])
}

model DeliveryReceipt {
  store     Store @relation(fields: [storeId], references: [id], onDelete: Cascade)
  storeId   String
  requestId String
  lines     Json
  createdAt DateTime @default(now())

  @@id([storeId, requestId])
}

model Listing {
  id                 String           @id @default(cuid())
  productPhotoUrl    String?
  store              Store            @relation(fields: [storeId], references: [id])
  storeId            String
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  canonicalProductId String
  priceCents         Int
  stockStatus        StockStatus      @default(in_stock)
  unitsAvailable     Int?
  pausedUntil        DateTime?
  leadTimeDays       Int?
  batchQuantityCap   Int?
  temperatureClass   TemperatureClass
  shippingWeightOz   Float
  /// CAT-5 — declared by the seller; wrong values produce PAY-9 chargebacks.
  lengthIn           Float            @default(8)
  widthIn            Float            @default(6)
  heightIn           Float            @default(4)
  /// PRD QC-5 -- the buyer-facing freshness/quality-guarantee badge, distinct from temperatureClass.
  freshnessGuarantee Boolean          @default(false)
  /// QC-1 — expiry rules. Short-dated goods may be listed only with disclosure.
  expiresOn          DateTime?
  shortDatedDisclosed Boolean         @default(false)
  cartItems          CartItem[]
  shipmentItems      ShipmentItem[]
  reviews            Review[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

/// Star rating + written review. Not explicitly named as its own entity in PRD
/// section 9, but implied as an input to QC-4's seller quality score -- modeled
/// here to support SRCH-3's product-detail review list.
model Review {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  buyerName String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Buyer {
  id            String         @id @default(cuid())
  email         String         @unique
  phone         String?
  userSessions  UserSession[]
  addresses     Address[]
  carts         Cart[]
  refundClaims  RefundClaim[]
  orders        Order[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Address {
  id        String  @id @default(cuid())
  buyer     Buyer   @relation(fields: [buyerId], references: [id])
  buyerId   String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  isDefault Boolean @default(false)
}

model Cart {
  id       String     @id @default(cuid())
  buyer    Buyer      @relation(fields: [buyerId], references: [id])
  buyerId  String
  items    CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id])
  cartId    String
  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String
  quantity  Int
}

model Order {
  id             String      @id @default(cuid())
  buyer          Buyer       @relation(fields: [buyerId], references: [id])
  buyerId        String
  status         OrderStatus @default(placed)
  totalCents     Int
  shippingCents  Int
  taxCents       Int
  shipments      Shipment[]
  payment        Payment?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Shipment {
  id                String            @id @default(cuid())
  order             Order             @relation(fields: [orderId], references: [id])
  orderId           String
  store             Store             @relation(fields: [storeId], references: [id])
  storeId           String
  temperatureClass  TemperatureClass
  carrier           String?
  trackingNumber    String?
  labelUrl          String?
  status            ShipmentStatus    @default(pending)
  declineReason      String?           @db.VarChar(500)
  estimatedDelivery DateTime?
  /// QC-2 — the seller's photo of the open box, taken before sealing. Metadata
  /// stripped on upload. A shipment cannot be marked shipped without one.
  packingPhotoUrl   String?
  packingPhotoAt    DateTime?
  pickup            ShipmentPickup?
  items             ShipmentItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

enum PickupState {
  awaiting_carrier
  test_scheduled
  cancelled
}

model ShipmentPickup {
  shipmentId  String      @id
  shipment    Shipment    @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  requestedAt DateTime    @default(now())
  state       PickupState @default(awaiting_carrier)
  windowStart DateTime?
  windowEnd   DateTime?
}

/// What is actually in a parcel. Hangs off Shipment rather than Order so the
/// CART-3 temperature split is preserved in the data, and so a store reading
/// its own shipment sees exactly its pack list and nothing from another store.
/// Name and price are snapshotted: listings change, a placed order must not.
model ShipmentItem {
  id                 String   @id @default(cuid())
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId         String
  listing            Listing  @relation(fields: [listingId], references: [id])
  listingId          String
  canonicalProductId String
  nameSnapshot       String
  packSizeSnapshot   String
  categorySnapshot   String
  quantity           Int
  reservedUnits      Int @default(0)
  unitPriceCents     Int
  lineTotalCents     Int
  claimItems         RefundClaimItem[]

  @@index([shipmentId])
}

model Payment {
  id                    String   @id @default(cuid())
  order                 Order    @relation(fields: [orderId], references: [id])
  orderId               String   @unique
  buyerChargeCents      Int
  stripePaymentIntentId String
  status                String   @default("requires_payment")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Payout {
  id                 String    @id @default(cuid())
  store              Store     @relation(fields: [storeId], references: [id])
  storeId            String
  orderId            String
  grossCents         Int
  takeRateBps        Int
  fulfilmentFeeCents Int
  netCents           Int
  status             String    @default("scheduled")
  /// PAY-8 — funds held until delivery is confirmed and the refund window closes.
  heldUntil          DateTime?
  holdReason         String?
  /// PAY-9 — carrier chargebacks deducted from this payout.
  adjustmentsCents   Int       @default(0)
  scheduledFor       DateTime?
  paidAt             DateTime?
  /// The note posted to the seller's AfriMart thread when this was paid.
  message            SellerMessage?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

/// A message from AfriMart in a seller's thread. Today only payouts post here
/// (the amount, the date and the orders it covers); the seller's earnings live
/// in this thread rather than on a screen of their own.
model SellerMessage {
  id          String    @id @default(cuid())
  store       Store     @relation(fields: [storeId], references: [id])
  storeId     String
  kind        String
  body        String
  /// One message per payout, so paying the same payout twice cannot post twice.
  payout      Payout?   @relation(fields: [payoutId], references: [id])
  payoutId    String?   @unique
  amountCents Int?
  paidOn      DateTime?
  orderRefs   String[]
  /// For a notice that must be posted once however often it is checked for
  /// (a lapsed licence): the same key is never written twice.
  dedupeKey   String?   @unique
  readAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([storeId, createdAt])
}

enum UserKind {
  buyer
  store
}

/// A one-time sign-in code for a buyer (emailed) or a store owner (texted).
/// Only a salted hash is kept, and a code is good for one successful use, a few
/// wrong guesses and a few minutes.
model AuthCode {
  id         String    @id @default(cuid())
  kind       UserKind
  purpose    String    @default("sign_in")
  /// Bind a store code to the account and phone assignment that received it.
  storeIdAtIssue String?
  storePhoneVersion Int?
  /// Normalised: a lower-case email for a buyer, an E.164 number for a store.
  identifier String
  salt       String
  codeHash   String
  attempts   Int       @default(0)
  expiresAt  DateTime
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([kind, identifier, createdAt])
}

/// A signed-in buyer or store. Opaque token, only its hash stored, revocable —
/// the same shape as a staff session, with a longer life because the owner of a
/// shop phone should not be asked for a texted code every morning.
model UserSession {
  id         String    @id @default(cuid())
  kind       UserKind
  buyer      Buyer?    @relation(fields: [buyerId], references: [id])
  buyerId    String?
  store      Store?    @relation(fields: [storeId], references: [id])
  storeId    String?
  tokenHash  String    @unique
  expiresAt  DateTime
  lastSeenAt DateTime  @default(now())
  revokedAt  DateTime?
  ip         String?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([buyerId])
  @@index([storeId])
}

model Subscription {
  id             String    @id @default(cuid())
  buyer          Buyer     @relation(fields: [buyerId], references: [id])
  buyerId        String
  type           String
  status         String    @default("active")
  cadence        String?
  nextRenewalAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// PAY-9 — a carrier billing correction, almost always caused by a seller
/// declaring the wrong weight or dimensions. Recorded against the seller who
/// declared them and deducted from their next payout.
model CarrierAdjustment {
  id                 String    @id @default(cuid())
  store              Store     @relation(fields: [storeId], references: [id])
  storeId            String
  shipmentId         String?
  carrierReference   String    @unique
  amountCents        Int
  reason             String
  declaredWeightOz   Float
  actualWeightOz     Float
  /// Set once folded into a payout, so an adjustment is never charged twice.
  settledPayoutId    String?
  createdAt          DateTime  @default(now())

  @@index([storeId, settledPayoutId])
}

/// QC-8 / QC-9 — a buyer's refund claim, the evidence for it, and where the
/// cost was ultimately recovered from.
model RefundClaim {
  id              String    @id @default(cuid())
  buyer           Buyer     @relation(fields: [buyerId], references: [id])
  buyerId         String
  orderId         String
  shipmentId      String?
  reason          String
  amountCents     Int
  /// QC-3 — "item" (goods that arrived wrong; photo required) or "parcel"
  /// (it never arrived; no photo, always reviewed).
  kind            String    @default("item")
  /// QC-8 — photo evidence is mandatory for spoiled or damaged goods.
  photoUrl        String?
  /// The buyer's own words, if they added any.
  note            String?
  items           RefundClaimItem[]
  /// Set only when a refund was actually issued, not merely approved.
  refundedAt      DateTime?
  refundId        String?
  /// auto_approved | manual_review | approved | rejected
  status          String    @default("manual_review")
  /// QC-8 — seller | carrier | platform. Who the cost is recovered from.
  recoveryTarget  String?
  recoveredCents  Int       @default(0)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([buyerId, createdAt])
}

enum CatalogueDraftStatus {
  pending_review
  approved
  rejected
}

/// CAT-6 / ADM-1 — an item the vision pass or an import read off a shelf, held
/// back from the public catalogue until a human confirms it. Everything the
/// merchant app captures lands here first; nothing reaches `Listing` without
/// passing through, which is what makes "no unverified path to public listing"
/// structural rather than a convention.
model CatalogueDraft {
  id                  String               @id @default(cuid())
  store               Store                @relation(fields: [storeId], references: [id])
  storeId             String
  jobId               String?
  job                 ExtractionJob?       @relation(fields: [jobId], references: [sessionId], onDelete: Cascade)
  sourceKey           String?
  photoRequestId      String?
  frameNames          String[]             @default([])
  candidateIds        String[]             @default([])
  brand               String?
  decision            String               @default("open")
  /// What the model actually read, kept verbatim so a reviewer can judge it.
  rawText             String
  suggestedName       String
  suggestedPriceCents Int?
  packSize            String?
  temperatureClass    TemperatureClass     @default(ambient)
  /// CAT-6 — below the threshold this cannot be auto-approved.
  confidence          Float
  /// CAT-3 — the canonical product entity resolution matched, if any.
  matchedProductId    String?
  status              CatalogueDraftStatus @default(pending_review)
  reviewNote          String?
  reviewedAt          DateTime?
  createdAt           DateTime             @default(now())

  @@index([status, confidence])
  @@index([jobId])
  @@unique([jobId, sourceKey])
}

/// Staff roles for the operations console. Deliberately coarse: four roles
/// that match how the team actually divides work, rather than a permission
/// matrix nobody maintains. A catalogue reviewer can never reach money.
enum StaffRole {
  catalogue_reviewer
  operations
  finance
  admin
}

/// An internal operator. Entirely separate from Buyer and from Store: staff
/// credentials must never be issuable through a buyer or merchant signup, and
/// no staff row is reachable from either app's API surface.
model StaffUser {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String
  /// scrypt, stored as "salt:derivedKey" — see src/auth/password.ts.
  passwordHash  String
  role          StaffRole
  /// Base32 TOTP secret. Null until the operator enrols a device.
  mfaSecret     String?
  mfaEnrolledAt DateTime?
  /// Set to lock an account out without deleting its audit trail.
  disabledAt    DateTime?
  lastLoginAt   DateTime?
  /// Rate limiting. Counted per account; cleared on a successful sign-in.
  failedLoginAttempts Int      @default(0)
  failedMfaAttempts   Int      @default(0)
  /// Set while an account is temporarily locked out after repeated failures.
  lockedUntil         DateTime?
  sessions      StaffSession[]
  auditEntries  AuditLogEntry[]
  onboardingInvites OnboardingInvite[]
  onboardingKits OnboardingKit[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

/// An invitation locates a store; it never replaces proof of phone ownership.
/// One resumable initial catalogue capture per store.
model FilmSession {
  id         String       @id @default(cuid())
  storeId    String       @unique
  store      Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  revision   Int          @default(0)
  finishedAt DateTime?
  createdAt  DateTime     @default(now())
  frames     ShelfFrame[]
  extraction ExtractionJob?
}

model ExtractionJob {
  websiteUrl  String?
  sessionId   String           @id
  session     FilmSession      @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  state       String           @default("queued")
  lease       String?
  leaseUntil  DateTime?
  attempts    Int              @default(0)
  message     String?
  revision    Int              @default(0)
  submittedAt DateTime?
  createdAt   DateTime         @default(now())
  drafts      CatalogueDraft[]

  @@index([state, leaseUntil])
}

model ExtractionUsage {
  id           String   @id @default(cuid())
  storeId      String
  model        String
  inputBytes   Int
  inputTokens  Int?
  outputTokens Int?
  micros       Int
  latencyMs    Int?
  createdAt    DateTime @default(now())

  @@index([storeId, createdAt])
}

model ShelfFrame {
  uploadedAt  DateTime     @default(now())
  name        String       @id
  sessionId   String?
  session     FilmSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  shelf       Int
  position    Int
  passId      String
  /// Detached rows track uploads and replaced photos until private storage is cleaned.
  deleteAfter DateTime?

  @@unique([sessionId, shelf, position])
  @@index([sessionId, deleteAfter])
  @@index([uploadedAt])
}

model OnboardingInvite {
  id          String   @id @default(cuid())
  storeId     String
  store       Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  tokenHash   String   @unique
  createdById String
  createdBy   StaffUser @relation(fields: [createdById], references: [id])
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())
  @@index([storeId])
}

model OnboardingKit {
  id                  String   @id @default(cuid())
  storeId             String
  store               Store    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  packaging           String
  labelPrinterSerial  String
  issuedAt            DateTime
  recordedById        String
  recordedBy          StaffUser @relation(fields: [recordedById], references: [id])
  createdAt           DateTime @default(now())
  @@index([storeId, issuedAt])
}

/// A logged-in staff session. Opaque random token, stored hashed, with real
/// server-side expiry and revocation — a signed stateless token could not be
/// revoked mid-shift, which is the whole point of holding these in the
/// database.
model StaffSession {
  id            String    @id @default(cuid())
  staffUser     StaffUser @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  staffUserId   String
  /// SHA-256 of the bearer token. The token itself is never stored.
  tokenHash     String    @unique
  /// Null until the second factor is satisfied; procedures require it set.
  mfaVerifiedAt DateTime?
  createdAt     DateTime  @default(now())
  lastSeenAt    DateTime  @default(now())
  expiresAt     DateTime
  revokedAt     DateTime?
  ip            String?
  userAgent     String?

  @@index([staffUserId])
}

/// Every action that moves money or changes a seller's standing. Written in
/// the same transaction as the change itself, so an audited action cannot
/// succeed without its log entry.
model AuditLogEntry {
  id          String     @id @default(cuid())
  actor       StaffUser? @relation(fields: [actorId], references: [id])
  actorId     String?
  /// Snapshotted so the trail survives the account being renamed or deleted.
  actorEmail  String
  actorRole   String
  action      String
  subjectType String
  subjectId   String
  /// State before and after, for anything that can be reversed or disputed.
  before      Json?
  after       Json?
  note        String?
  createdAt   DateTime   @default(now())

  @@index([subjectType, subjectId])
  @@index([createdAt])
  @@index([actorId])
}

/// NTF-1 — a carrier tracking callback, stored before it is acted on.
///
/// Webhooks are retried, arrive twice, and arrive out of order. Recording the
/// provider's own event id with a unique constraint makes replay a no-op: the
/// second insert fails and the handler stops, rather than sending a second
/// "shipped" email. Storing the raw payload means a mis-handled event can be
/// replayed after a fix instead of being lost.
model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  /// The carrier's id for this event. Unique: this is the deduplication.
  providerEventId String    @unique
  shipmentId      String?
  /// Carrier status as sent, before mapping onto our own state machine.
  rawStatus       String
  /// When the carrier says it happened, which is not when we received it.
  occurredAt      DateTime
  payload         Json
  receivedAt      DateTime  @default(now())
  processedAt     DateTime?
  /// Set when an event was valid but deliberately not applied, with why.
  ignoredReason   String?

  @@index([shipmentId, occurredAt])
}

enum NotificationChannel {
  email
  push
  sms
}

enum NotificationStatus {
  pending
  sent
  failed
  suppressed
}

/// NTF-2/NTF-4 — the transactional outbox.
///
/// Written in the same transaction as the state change that causes it, and
/// sent only after that transaction commits. A rolled-back order therefore
/// cannot email anyone, and a crash between commit and send loses nothing:
/// the row is still pending and the next drain picks it up.
///
/// `dedupeKey` is the "one email per parcel per state" rule, enforced by the
/// database rather than by remembering to check.
model Notification {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  template   String
  recipient  String
  subject    String
  body       String
  dedupeKey  String              @unique
  status     NotificationStatus  @default(pending)
  attempts   Int                 @default(0)
  nextAttemptAt DateTime?
  lastError  String?
  orderId    String?
  shipmentId String?
  createdAt  DateTime            @default(now())
  sentAt     DateTime?

  @@index([status, createdAt])
}

enum BadgeKind {
  diaspora_owned
  imported_direct
  made_in_usa_african_brand
}

enum BadgeStatus {
  applied
  approved
  rejected
  revoked
}

/// CAT-8 — an authenticity or provenance claim a seller has *applied* for.
///
/// Never self-declared: a badge only becomes visible once a reviewer approves
/// it, and the approval is audited like any other change to a seller's
/// standing. A badge a seller can switch on themselves tells a buyer nothing,
/// which defeats the point of having one.
model SellerBadge {
  id         String      @id @default(cuid())
  store      Store       @relation(fields: [storeId], references: [id])
  storeId    String
  kind       BadgeKind
  status     BadgeStatus @default(applied)
  /// What the seller submitted in support of the claim.
  evidence   String?
  reviewNote String?
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())

  @@unique([storeId, kind])
}

enum EnforcementLevel {
  warning
  reduced_visibility
  suspended
  delisted
  cleared
}

/// QC-6 — a step on the enforcement ladder, and who took it.
///
/// Warnings and reduced visibility may be applied automatically once a seller
/// has enough orders to judge. Suspension and delisting may not: those end a
/// livelihood, and the PRD's "administered through the operations console"
/// is read here as requiring a person. `actorEmail` is null exactly when the
/// system acted, which makes the distinction auditable rather than implied.
model SellerEnforcement {
  id          String           @id @default(cuid())
  store       Store            @relation(fields: [storeId], references: [id])
  storeId     String
  level       EnforcementLevel
  reason      String
  /// Null for an automatic action; set when a human decided.
  actorEmail  String?
  /// The score and sample size the decision was taken on, kept for appeal.
  scoreAtTime Float?
  ordersAtTime Int?
  createdAt   DateTime         @default(now())

  @@index([storeId, createdAt])
}

/// QC-1 — the food categories that carry their own permit and that operations
/// can switch off. Home-based and aspiring sellers may list all four by
/// default; stores are never subject to any of this.
enum ControlledCategory {
  meat
  poultry
  fish
  dairy
}

enum KitchenLicenceStatus {
  applied
  approved
  rejected
  revoked
}

/// QC-1 — a seller's claim to produce in a licensed commercial kitchen, which
/// is what lifts the chilled-and-frozen restriction.
///
/// Applied for, never self-declared: the row starts as `applied` and only a
/// reviewer who has checked the licence moves it to `approved`. The decision
/// is audited in the same transaction, like a CAT-8 badge. One row per
/// store; a fresh application after a rejection reuses it, and the audit
/// trail keeps every earlier decision.
model KitchenLicence {
  id              String               @id @default(cuid())
  store           Store                @relation(fields: [storeId], references: [id])
  storeId         String               @unique
  status          KitchenLicenceStatus @default(applied)
  /// Optional: a seller may send a photo of the licence instead, which a reviewer reads.
  licenceNumber   String?
  issuingAuthority String?
  /// What the seller submitted in support (a document link or reference).
  evidence        String?
  reviewNote      String?
  reviewedAt      DateTime?
  reviewedByEmail String?
  /// What the reviewer read off the licence when approving, entered by them and
  /// not taken from the seller: the number, who issued it, and when it lapses.
  /// All three are required to approve. A licence counts through its expiry date
  /// and not after: the chilled and frozen listings are hidden by date at read
  /// time (quality/licence.ts). The renewal warning ahead of it is not built yet.
  verifiedLicenceNumber     String?
  verifiedIssuingAuthority  String?
  licenceExpiresOn          DateTime? @db.Date
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
}

/// QC-1 — operations has switched one controlled category off for one seller.
/// Their existing listings in it are hidden and new ones are refused. The row
/// is the current state; every change is written to the audit log with who,
/// when and why.
model SellerCategoryControl {
  id         String             @id @default(cuid())
  store      Store              @relation(fields: [storeId], references: [id])
  storeId    String
  category   ControlledCategory
  disabled   Boolean
  reason     String
  actorEmail String
  updatedAt  DateTime           @updatedAt

  @@unique([storeId, category])
}

/// QC-1 — the platform-wide switch for a controlled category, applying to
/// every home-based and aspiring seller at once. A database setting rather
/// than a constant so it can be flipped the day legal advice changes, without
/// a deploy. No row means enabled, which is the default.
model PlatformCategoryControl {
  category   ControlledCategory @id
  disabled   Boolean
  reason     String
  actorEmail String
  updatedAt  DateTime           @updatedAt
}

/// QC-1 — a home-based or aspiring seller's one-time statement that they hold
/// whatever permit their state requires for a controlled category, stored
/// with when they made it. Per category: a meat permit says nothing about
/// dairy. `statementVersion` records which wording they agreed to.
model PermitConfirmation {
  id               String             @id @default(cuid())
  store            Store              @relation(fields: [storeId], references: [id])
  storeId          String
  category         ControlledCategory
  statementVersion String
  confirmedAt      DateTime           @default(now())

  @@unique([storeId, category])
}

/// QC-3 — which items a report covers. A report can name several items from one
/// parcel under one reason and one photo; each item is held by at most one open
/// report so the same goods cannot be refunded twice. The line total is
/// snapshotted: what was refunded must not move if the listing later does.
model RefundClaimItem {
  id             String       @id @default(cuid())
  claim          RefundClaim  @relation(fields: [claimId], references: [id], onDelete: Cascade)
  claimId        String
  shipmentItem   ShipmentItem @relation(fields: [shipmentItemId], references: [id])
  shipmentItemId String
  lineTotalCents Int

  @@unique([claimId, shipmentItemId])
  @@index([shipmentItemId])
}
