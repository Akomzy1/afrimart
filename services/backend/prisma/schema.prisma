// First-pass schema mirroring packages/shared's types and PRD section 9's
// data model. Field-level detail will grow as Prompt 8 (catalogue, orders,
// routing, payments) is built out — this is the scaffold, not the final shape.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TemperatureClass {
  ambient
  refrigerated
  frozen
}

enum SellerType {
  store
  home_seller
  aspiring_entrepreneur
}

enum OnboardingStatus {
  pending
  filming
  reviewing
  kit_issued
  live
  suspended
  delisted
}

enum StockStatus {
  in_stock
  made_to_order
  out_of_stock
}

enum OrderStatus {
  placed
  accepted
  packed
  shipped
  delivered
  cancelled
}

enum ShipmentStatus {
  pending
  label_created
  picked_up
  in_transit
  delivered
  exception
}

model HubMetro {
  id        String   @id @default(cuid())
  name      String
  state     String
  active    Boolean  @default(true)
  stores    Store[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Store {
  id                    String            @id @default(cuid())
  name                  String
  ownerName             String
  sellerType            SellerType
  hubMetro              HubMetro          @relation(fields: [hubMetroId], references: [id])
  hubMetroId            String
  onboardingStatus      OnboardingStatus  @default(pending)
  verificationStatus    String            @default("unverified")
  foodSafetyAttestedAt  DateTime?
  verifiedAt            DateTime?
  qualityScore          Float?
  payoutAccountId       String?
  listings              Listing[]
  shipments             Shipment[]
  payouts               Payout[]
  carrierAdjustments    CarrierAdjustment[]
  catalogueDrafts       CatalogueDraft[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt
}

model CanonicalProduct {
  id                String            @id @default(cuid())
  canonicalName     String
  /// Short plain-English gloss, e.g. "melon seeds" -- composed with canonicalName/packSize for card subtitles.
  shortDescription  String
  /// AGT-6 grounding text and the product page's "How it's used" copy.
  usedDescription   String
  category          String
  cuisine           String
  packSize          String
  images            String[]
  temperatureClass  TemperatureClass
  shippingWeightOz  Float
  /// CAT-5 — carriers bill the greater of actual and dimensional weight.
  lengthIn          Float            @default(8)
  widthIn           Float            @default(6)
  heightIn          Float            @default(4)
  aliases           NameAlias[]
  listings          Listing[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

model NameAlias {
  id                 String           @id @default(cuid())
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  canonicalProductId String
  alias              String
  language           String
  confidence         Float

  @@index([alias])
}

model Listing {
  id                 String           @id @default(cuid())
  store              Store            @relation(fields: [storeId], references: [id])
  storeId            String
  canonicalProduct   CanonicalProduct @relation(fields: [canonicalProductId], references: [id])
  canonicalProductId String
  priceCents         Int
  stockStatus        StockStatus      @default(in_stock)
  leadTimeDays       Int?
  batchQuantityCap   Int?
  temperatureClass   TemperatureClass
  shippingWeightOz   Float
  /// CAT-5 — declared by the seller; wrong values produce PAY-9 chargebacks.
  lengthIn           Float            @default(8)
  widthIn            Float            @default(6)
  heightIn           Float            @default(4)
  /// PRD QC-5 -- the buyer-facing freshness/quality-guarantee badge, distinct from temperatureClass.
  freshnessGuarantee Boolean          @default(false)
  cartItems          CartItem[]
  shipmentItems      ShipmentItem[]
  reviews            Review[]
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt
}

/// Star rating + written review. Not explicitly named as its own entity in PRD
/// section 9, but implied as an input to QC-4's seller quality score -- modeled
/// here to support SRCH-3's product-detail review list.
model Review {
  id        String   @id @default(cuid())
  listing   Listing  @relation(fields: [listingId], references: [id])
  listingId String
  buyerName String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
}

model Buyer {
  id            String         @id @default(cuid())
  email         String         @unique
  phone         String?
  addresses     Address[]
  carts         Cart[]
  refundClaims  RefundClaim[]
  orders        Order[]
  subscriptions Subscription[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
}

model Address {
  id        String  @id @default(cuid())
  buyer     Buyer   @relation(fields: [buyerId], references: [id])
  buyerId   String
  line1     String
  line2     String?
  city      String
  state     String
  zip       String
  isDefault Boolean @default(false)
}

model Cart {
  id       String     @id @default(cuid())
  buyer    Buyer      @relation(fields: [buyerId], references: [id])
  buyerId  String
  items    CartItem[]
}

model CartItem {
  id        String  @id @default(cuid())
  cart      Cart    @relation(fields: [cartId], references: [id])
  cartId    String
  listing   Listing @relation(fields: [listingId], references: [id])
  listingId String
  quantity  Int
}

model Order {
  id             String      @id @default(cuid())
  buyer          Buyer       @relation(fields: [buyerId], references: [id])
  buyerId        String
  status         OrderStatus @default(placed)
  totalCents     Int
  shippingCents  Int
  taxCents       Int
  shipments      Shipment[]
  payment        Payment?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
}

model Shipment {
  id                String            @id @default(cuid())
  order             Order             @relation(fields: [orderId], references: [id])
  orderId           String
  store             Store             @relation(fields: [storeId], references: [id])
  storeId           String
  temperatureClass  TemperatureClass
  carrier           String?
  trackingNumber    String?
  labelUrl          String?
  status            ShipmentStatus    @default(pending)
  estimatedDelivery DateTime?
  packingPhotoUrl   String?
  items             ShipmentItem[]
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
}

/// What is actually in a parcel. Hangs off Shipment rather than Order so the
/// CART-3 temperature split is preserved in the data, and so a store reading
/// its own shipment sees exactly its pack list and nothing from another store.
/// Name and price are snapshotted: listings change, a placed order must not.
model ShipmentItem {
  id                 String   @id @default(cuid())
  shipment           Shipment @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  shipmentId         String
  listing            Listing  @relation(fields: [listingId], references: [id])
  listingId          String
  canonicalProductId String
  nameSnapshot       String
  packSizeSnapshot   String
  categorySnapshot   String
  quantity           Int
  unitPriceCents     Int
  lineTotalCents     Int

  @@index([shipmentId])
}

model Payment {
  id                    String   @id @default(cuid())
  order                 Order    @relation(fields: [orderId], references: [id])
  orderId               String   @unique
  buyerChargeCents      Int
  stripePaymentIntentId String
  status                String   @default("requires_payment")
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model Payout {
  id                 String    @id @default(cuid())
  store              Store     @relation(fields: [storeId], references: [id])
  storeId            String
  orderId            String
  grossCents         Int
  takeRateBps        Int
  fulfilmentFeeCents Int
  netCents           Int
  status             String    @default("scheduled")
  /// PAY-8 — funds held until delivery is confirmed and the refund window closes.
  heldUntil          DateTime?
  holdReason         String?
  /// PAY-9 — carrier chargebacks deducted from this payout.
  adjustmentsCents   Int       @default(0)
  scheduledFor       DateTime?
  paidAt             DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model Subscription {
  id             String    @id @default(cuid())
  buyer          Buyer     @relation(fields: [buyerId], references: [id])
  buyerId        String
  type           String
  status         String    @default("active")
  cadence        String?
  nextRenewalAt  DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}

/// PAY-9 — a carrier billing correction, almost always caused by a seller
/// declaring the wrong weight or dimensions. Recorded against the seller who
/// declared them and deducted from their next payout.
model CarrierAdjustment {
  id                 String    @id @default(cuid())
  store              Store     @relation(fields: [storeId], references: [id])
  storeId            String
  shipmentId         String?
  carrierReference   String    @unique
  amountCents        Int
  reason             String
  declaredWeightOz   Float
  actualWeightOz     Float
  /// Set once folded into a payout, so an adjustment is never charged twice.
  settledPayoutId    String?
  createdAt          DateTime  @default(now())

  @@index([storeId, settledPayoutId])
}

/// QC-8 / QC-9 — a buyer's refund claim, the evidence for it, and where the
/// cost was ultimately recovered from.
model RefundClaim {
  id              String    @id @default(cuid())
  buyer           Buyer     @relation(fields: [buyerId], references: [id])
  buyerId         String
  orderId         String
  shipmentId      String?
  reason          String
  amountCents     Int
  /// QC-8 — photo evidence is mandatory for spoiled or damaged goods.
  photoUrl        String?
  /// auto_approved | manual_review | approved | rejected
  status          String    @default("manual_review")
  /// QC-8 — seller | carrier | platform. Who the cost is recovered from.
  recoveryTarget  String?
  recoveredCents  Int       @default(0)
  createdAt       DateTime  @default(now())
  resolvedAt      DateTime?

  @@index([buyerId, createdAt])
}

enum CatalogueDraftStatus {
  pending_review
  approved
  rejected
}

/// CAT-6 / ADM-1 — an item the vision pass or an import read off a shelf, held
/// back from the public catalogue until a human confirms it. Everything the
/// merchant app captures lands here first; nothing reaches `Listing` without
/// passing through, which is what makes "no unverified path to public listing"
/// structural rather than a convention.
model CatalogueDraft {
  id                  String               @id @default(cuid())
  store               Store                @relation(fields: [storeId], references: [id])
  storeId             String
  /// What the model actually read, kept verbatim so a reviewer can judge it.
  rawText             String
  suggestedName       String
  suggestedPriceCents Int?
  packSize            String?
  temperatureClass    TemperatureClass     @default(ambient)
  /// CAT-6 — below the threshold this cannot be auto-approved.
  confidence          Float
  /// CAT-3 — the canonical product entity resolution matched, if any.
  matchedProductId    String?
  status              CatalogueDraftStatus @default(pending_review)
  reviewNote          String?
  reviewedAt          DateTime?
  createdAt           DateTime             @default(now())

  @@index([status, confidence])
}
